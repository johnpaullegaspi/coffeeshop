  "testimonials": [
    {
      "name": "Sarah Mitchell",
      "rating": 5,
      "comment": "The Brew Haven is my absolute favorite spot in the city. The cold brew is unmatched, and the atmosphere is perfect for both work and relaxation. The staff always remembers my order!",
      "photo": "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop",
      "role": "Regular Customer"
    },
    {
      "name": "James Chen",
      "rating": 5,
      "comment": "As a coffee enthusiast, I have high standards. The Brew Haven exceeds them all. Their pour-over selection is exceptional, and the baristas truly understand the craft.",
      "photo": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop",
      "role": "Coffee Blogger"
    },
    {
      "name": "Emily Rodriguez",
      "rating": 5,
      "comment": "The brown sugar milk tea here is absolutely divine. Perfect sweetness, chewy pearls, and the creamiest milk. My friends and I come here every weekend!",
      "photo": "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop",
      "role": "Verified Customer"
    },
    {
      "name": "Michael Park",
      "rating": 4,
      "comment": "Great place for meetings. The Wi-Fi is fast, the seating is comfortable, and the avocado toast is the best I have had. Highly recommend for remote workers.",
      "photo": "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&fit=crop",
      "role": "Freelance Designer"
    },
    {
      "name": "Lisa Thompson",
      "rating": 5,
      "comment": "We had my birthday celebration here and the team went above and beyond. Reserved a beautiful corner table and even made a custom latte art with my name!",
      "photo": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&h=100&fit=crop",
      "role": "Verified Customer"
    },
    {
      "name": "David Kim",
      "rating": 5,
      "comment": "The attention to detail here is incredible. From the ethically sourced beans to the beautiful interior design, everything speaks quality. A true gem.",
      "photo": "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop",
      "role": "Food Critic"
    }
  ],
  "aboutPage": {
    "pageTitle": "Our Story",
    "pageSubtitle": "A journey of passion, quality, and community.",
    "storyTitle": "How It All Started",
    "story": "The Brew Haven began in 2019 as a small dream shared by two friends who believed that coffee should be more than just caffeine — it should be an experience. What started as a tiny corner shop with three tables and a single espresso machine has grown into a beloved community gathering place.\n\nWe source our beans directly from sustainable farms in Ethiopia, Colombia, and Guatemala, ensuring that every cup supports both exceptional quality and ethical practices. Our milk tea recipes were developed over months of careful testing, blending traditional techniques with modern flavors.",
    "mission": "Our mission is simple: to create a warm, welcoming space where exceptional beverages bring people together. We believe in quality over quantity, community over competition, and sustainability in everything we do. Every ingredient is chosen with care, every drink is crafted with passion, and every guest is treated like family.",
    "storyImage": "https://images.unsplash.com/photo-1442512595331-e89e73853f31?w=800&h=600&fit=crop",
    "previewImage": "https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=800&h=600&fit=crop"
  },
  "values": [
    {
      "title": "Quality First",
      "description": "We never compromise on ingredients. From single-origin beans to fresh dairy, every component is carefully selected.",
      "icon": "award"
    },
    {
      "title": "Sustainability",
      "description": "Eco-friendly packaging, ethical sourcing, and a commitment to reducing our environmental footprint.",
      "icon": "leaf"
    },
